# Local PostgreSQL — application data except authentication identities
POSTGRES_DB=isoguard
POSTGRES_USER=isoguard
POSTGRES_PASSWORD=change-me
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=isoguard;Username=isoguard;Password=change-me

# Supabase Auth
Jwt__Authority=https://YOUR_PROJECT.supabase.co/auth/v1
Jwt__Audience=authenticated
Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__ServiceRoleKey=server-only-secret

# Optional idempotent initial administrator bootstrap
SeedAdmin__Enabled=true
SeedAdmin__Email=admin@example.com
SeedAdmin__FullName=Initial Administrator

# Transactional email (backend only)
Email__Provider=Smtp
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=your-address@gmail.com
Email__SmtpPassword=your-google-app-password
Email__SmtpEnableSsl=true
Email__FromAddress=your-address@gmail.com
Email__FromName=IsoGuard

# Internal ML service
MlService__BaseUrl=http://localhost:8000
